# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# From your Spotify app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Obtained once by running:  python -m src.auth
SPOTIFY_REFRESH_TOKEN=

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# Spotify requires https or a loopback address — use 127.0.0.1, not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: pin the playlist so the script never has to find it by name.
# Fill this in after the first successful run (it's printed + saved to data/state.json).
SPOTIFY_PLAYLIST_ID=
